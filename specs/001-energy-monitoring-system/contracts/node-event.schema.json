{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unmsm:energy:v1:node-event",
  "title": "Monitoring node event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "node_id",
    "circuit_id",
    "boot_id",
    "sequence",
    "observed_at",
    "event_type",
    "severity",
    "config_version",
    "measured_value",
    "threshold_value",
    "unit",
    "quality",
    "local_warning_active"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "node_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "circuit_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "boot_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "observed_at": { "type": "string", "format": "date-time" },
    "event_type": { "enum": ["threshold_entered", "threshold_cleared", "measurement_quality_changed"] },
    "severity": { "enum": ["info", "warning", "critical"] },
    "config_version": { "type": "integer", "minimum": 1 },
    "measured_value": { "type": ["number", "null"] },
    "threshold_value": { "type": ["number", "null"], "minimum": 0 },
    "unit": { "enum": ["W", "none"] },
    "quality": { "enum": ["valid", "degraded", "invalid"] },
    "local_warning_active": { "type": "boolean" },
    "reason_code": { "type": ["string", "null"], "maxLength": 64 }
  }
}
