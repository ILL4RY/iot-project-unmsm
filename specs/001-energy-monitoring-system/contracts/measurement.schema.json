{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unmsm:energy:v1:measurement",
  "title": "Energy measurement window",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "node_id",
    "circuit_id",
    "boot_id",
    "sequence",
    "window",
    "clock",
    "measurements",
    "quality",
    "uptime_ms"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "message_id": { "$ref": "#/$defs/uuidV4" },
    "node_id": { "$ref": "#/$defs/identifier" },
    "circuit_id": { "$ref": "#/$defs/identifier" },
    "boot_id": { "$ref": "#/$defs/uuidV4" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "duration_ms", "sample_count"],
      "properties": {
        "start": { "$ref": "#/$defs/utcMillis" },
        "end": { "$ref": "#/$defs/utcMillis" },
        "duration_ms": { "type": "integer", "minimum": 4000, "maximum": 10000 },
        "sample_count": { "type": "integer", "minimum": 0, "maximum": 40000 }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "last_sync_age_s"],
      "properties": {
        "source": { "enum": ["sntp", "holdover", "unsynchronized"] },
        "last_sync_age_s": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voltage_rms", "current_rms", "active_power", "active_energy_import_total"],
      "properties": {
        "voltage_rms": { "$ref": "#/$defs/voltage" },
        "current_rms": { "$ref": "#/$defs/current" },
        "active_power": { "$ref": "#/$defs/power" },
        "active_energy_import_total": { "$ref": "#/$defs/energy" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "flags", "valid_sample_ratio", "calibration_revision"],
      "properties": {
        "state": { "enum": ["valid", "degraded", "invalid"] },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "clock_unsynchronized",
              "calibration_missing",
              "sample_gap",
              "adc_crc_error",
              "adc_clipped",
              "sensor_disconnected",
              "out_of_range",
              "polarity_reversed",
              "energy_continuity_uncertain"
            ]
          }
        },
        "valid_sample_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "calibration_revision": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 }
      }
    },
    "uptime_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "quality": {
            "properties": { "state": { "const": "valid" } },
            "required": ["state"]
          }
        }
      },
      "then": {
        "properties": {
          "measurements": {
            "properties": {
              "voltage_rms": { "properties": { "value": { "type": "number" } } },
              "current_rms": { "properties": { "value": { "type": "number" } } },
              "active_power": { "properties": { "value": { "type": "number" } } },
              "active_energy_import_total": { "properties": { "value": { "type": "number" } } }
            }
          },
          "quality": {
            "properties": {
              "valid_sample_ratio": { "minimum": 0.99 },
              "calibration_revision": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "quality": {
            "properties": { "state": { "const": "invalid" } },
            "required": ["state"]
          }
        }
      },
      "then": {
        "properties": {
          "measurements": {
            "properties": {
              "voltage_rms": { "properties": { "value": { "type": "null" } } },
              "current_rms": { "properties": { "value": { "type": "null" } } },
              "active_power": { "properties": { "value": { "type": "null" } } },
              "active_energy_import_total": { "properties": { "value": { "type": "null" } } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcMillis": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "voltage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 300 },
        "unit": { "const": "V" }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 20 },
        "unit": { "const": "A" }
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": -3000, "maximum": 3000 },
        "unit": { "const": "W" }
      }
    },
    "energy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "counter_id"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0 },
        "unit": { "const": "Wh" },
        "counter_id": { "$ref": "#/$defs/uuidV4" }
      }
    }
  }
}
